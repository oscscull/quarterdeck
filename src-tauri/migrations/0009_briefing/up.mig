# up.mig — generated by `based migrate gen`.
#
# The structural steps below are derived from schema.snap at apply time. Editing a
# structural line here has NO effect on what applies; `based migrate apply` refuses a
# migration whose structural lines diverge from schema.snap.
#
# Every line runs in the order written. What you CAN add between the steps:
#   - data steps over the table and column names as of that line, e.g.
#         update all card { paper = true }
#         delete event where (created_at < "2024-01-01") chunk 10000
#   - raw(<dialect>) `<sql>` lines for SQL the steps can't express. Multi-line SQL goes in
#     a backtick block:
#         raw(sqlite) `
#         ... statements ...
#         `
#   - a hand-authored down.mig (raw per-dialect SQL) for rollback.
format 2
create table area_briefing {
  column area text not_null
  column text json not_null
  column written_at timestamp not_null
}
create table project {
  column aim text not_null
  column area text not_null
  column briefed_at timestamp null
  column briefing json null
  column id text not_null
  column opened_at timestamp not_null
  column rank int not_null
  column state enum(moving,stalled,quiet,done) not_null
  column state_since timestamp not_null
  column title text not_null
  index idx_project_area_rank (area, rank)
}
create table reference {
  column area text not_null
  column at timestamp not_null
  column by enum(you,agent) not_null
  column id serial not_null
  column kind enum(you_said,ticket,pr,comment,slack,doc,commit,config,other) not_null
  column project_id text null fk=Project
  column quote text not_null
  column title text not_null
  column url text null
  index idx_reference_area_at (area, at)
  fk project_id -> project.id on_delete=cascade
}
create table reference_item {
  column item_id text not_null fk=Item
  column reference_id int not_null fk=Reference
  fk item_id -> item.id on_delete=cascade
  fk reference_id -> reference.id on_delete=cascade
}
add column item.project_id text null fk=Project
add column item_event.trace bool not_null default=false
# Everything but notes is bookkeeping; notes are the record.
raw(sqlite) `UPDATE item_event SET trace = 1 WHERE json_extract(change, '$.kind') <> 'note'`
add index idx_item_event_trace_at (trace, at)
add foreign_key item.project_id -> project.id on_delete=set_null
