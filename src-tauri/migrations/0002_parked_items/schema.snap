# schema.snap — generated by `based migrate gen`; do not edit by hand.
snapshot v1 dialect=neutral

table activity sort=(at desc, id desc)
  column area text not_null
  column at timestamp not_null
  column id serial not_null
  column text text not_null
  column unread bool not_null
  index idx_activity_at (at)

table alert_state sort=(commitment asc) pk=commitment_id
  column commitment_id int not_null fk=Commitment
  column done bool not_null default=false
  column snoozed_until timestamp null
  fk commitment_id -> commitment.id on_delete=cascade

table ask sort=(id asc)
  column answer text null
  column context text not_null
  column cwd text null
  column id serial not_null
  column item_id text not_null fk=Item
  column options json not_null
  column question text not_null
  column session text null
  index idx_ask_answer (answer)
  index idx_ask_item_id_answer (item_id, answer)
  fk item_id -> item.id on_delete=cascade

table commitment sort=(starts_at asc, id asc)
  column area text not_null
  column ends_at timestamp not_null
  column external_id text null
  column hidden bool not_null default=false
  column id serial not_null
  column join_url text null
  column location text null
  column source text not_null
  column starts_at timestamp not_null
  column title text not_null
  index idx_commitment_ends_at (ends_at)
  index idx_commitment_hidden_starts_at (hidden, starts_at)
  index uq_commitment_source_external_id (source, external_id) unique

table item sort=(rank asc)
  column area text not_null
  column external_id text null
  column hidden bool not_null default=false
  column holder text not_null
  column id text not_null
  column link text null
  column opened_at timestamp not_null
  column parked bool not_null default=false
  column rank int not_null
  column source text not_null default="manual"
  column stage enum(up_next,in_progress,in_review,done) not_null
  column state_label text not_null
  column state_since timestamp not_null
  column status enum(decision,review,ci,ci_failed,dependency,approved,proceeding,queued) null
  column title text not_null
  index idx_item_hidden_parked_rank (hidden, parked, rank)
  index idx_item_stage_state_since (stage, state_since)
  index uq_item_source_external_id (source, external_id) unique

table item_event sort=(at desc, id desc)
  column at timestamp not_null
  column change json not_null
  column id serial not_null
  column item_id text not_null fk=Item
  index idx_item_event_item_id_at (item_id, at)
  fk item_id -> item.id on_delete=cascade

table meta pk=key
  column key text not_null
  column value text not_null

table run
  column finished_at timestamp null
  column id serial not_null
  column node text not_null
  column outcome enum(ok,failed,missed) null
  column schedule_id text null
  column started_at timestamp not_null
  column summary text null
  column target text not_null
  column what text not_null
  index idx_run_finished_at_started_at (finished_at, started_at)
  index idx_run_schedule_id_started_at (schedule_id, started_at)

table run_request sort=(id asc)
  column id serial not_null
  column schedule_id text not_null

table sync_state pk=(source, external_id)
  column external_id text not_null
  column snapshot text not_null
  column source text not_null

table todo
  column area text not_null
  column done_at timestamp null
  column due date null
  column id serial not_null
  column title text not_null
  index idx_todo_done_at (done_at)

table urgent sort=(raised_at desc, id desc)
  column area text not_null
  column detail text not_null
  column id serial not_null
  column raised_at timestamp not_null
  column schedule_id text null
  column title text not_null

table watch sort=(item asc) pk=item_id
  column cwd text null
  column item_id text not_null fk=Item
  column last_nudge timestamp null
  column nudges int not_null default=0
  column session text null
  fk item_id -> item.id on_delete=cascade
