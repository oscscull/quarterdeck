# up.mig — generated by `based migrate gen`.
#
# The structural steps below are derived from schema.snap at apply time. Editing a
# structural line here has NO effect on what applies; `based migrate apply` refuses a
# migration whose structural lines diverge from schema.snap.
#
# Every line runs in the order written. What you CAN add between the steps:
#   - data steps over the table and column names as of that line, e.g.
#         update all card { paper = true }
#         delete event where (created_at < "2024-01-01") chunk 10000
#   - raw(<dialect>) `<sql>` lines for SQL the steps can't express. Multi-line SQL goes in
#     a backtick block:
#         raw(sqlite) `
#         ... statements ...
#         `
#   - a hand-authored down.mig (raw per-dialect SQL) for rollback.
format 2
add column item.then_turn enum(you,agent,others,later) null
add column item.turn enum(you,agent,others,later) not_null default="you"
add column item.turn_until timestamp null
add column item.waiting_on text null
# Items waiting on reviewers, CI or a dependency are others' turn, waiting on whoever held them,
# unless that was the user or Claude.
# Nothing starts as the agent's turn: a migrated item mustn't start a run on its own.
raw(sqlite) `
UPDATE item SET turn = 'others', waiting_on = holder
  WHERE status IN ('review', 'ci', 'dependency') AND holder NOT IN ('you', 'Claude');
UPDATE item SET status = NULL WHERE status = 'proceeding';
UPDATE item_event SET change = json_set(change, '$.status', json('null'))
  WHERE json_extract(change, '$.kind') = 'status' AND json_extract(change, '$.status') = 'proceeding';
`
drop column item.holder  # DESTRUCTIVE
drop column watch.last_nudge  # DESTRUCTIVE
drop column watch.nudges  # DESTRUCTIVE
add index idx_run_target_finished_at (target, finished_at)
