# up.mig — generated by `based migrate gen`.
#
# The structural steps below are derived from schema.snap at apply time. Editing a
# structural line here has NO effect on what applies; `based migrate apply` refuses a
# migration whose structural lines diverge from schema.snap.
#
# Every line runs in the order written. What you CAN add between the steps:
#   - data steps over the table and column names as of that line, e.g.
#         update all card { paper = true }
#         delete event where (created_at < "2024-01-01") chunk 10000
#   - raw(<dialect>) `<sql>` lines for SQL the steps can't express. Multi-line SQL goes in
#     a backtick block:
#         raw(sqlite) `
#         ... statements ...
#         `
#   - a hand-authored down.mig (raw per-dialect SQL) for rollback.
format 2
drop index idx_item_hidden_parked_rank
add column item.need text null
add column item.wake json null
alter column item.turn null drop default
raw(sqlite) `
UPDATE item SET stage = 'in_progress'
  WHERE stage = 'up_next' AND (
    id IN (SELECT item_id FROM item_event WHERE json_extract(change, '$.kind') = 'turn')
    OR id IN (SELECT item_id FROM ask WHERE answer IS NULL));
UPDATE item SET turn = NULL, turn_until = NULL, waiting_on = NULL, then_turn = NULL
  WHERE stage IN ('up_next', 'done');
UPDATE item SET turn = 'later', turn_until = strftime('%Y-%m-%dT%H:%M:%f000Z', 'now'),
    then_turn = 'you', waiting_on = NULL
  WHERE parked = 1 AND stage IN ('in_progress', 'in_review');
UPDATE item SET turn = 'you' WHERE stage IN ('in_progress', 'in_review') AND turn IS NULL;
UPDATE item SET need = coalesce(
    nullif(trim(state_label), ''),
    (SELECT json_extract(e.change, '$.why') FROM item_event e
     WHERE e.item_id = item.id AND json_extract(e.change, '$.kind') = 'turn'
     ORDER BY e.at DESC LIMIT 1),
    'What should happen next?')
  WHERE turn = 'you';
UPDATE item SET status = NULL WHERE status = 'decision';
UPDATE item_event SET change = json_set(change, '$.status', json('null'))
  WHERE json_extract(change, '$.kind') = 'status' AND json_extract(change, '$.status') = 'decision';
UPDATE sync_state SET snapshot = json_set(snapshot, '$.owned.status', json('null'))
  WHERE json_extract(snapshot, '$.owned.status') = 'decision';
`
drop column item.parked  # DESTRUCTIVE
add index idx_item_hidden_rank (hidden, rank)
